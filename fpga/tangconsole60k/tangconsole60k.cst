// Tang Console 60K (GW5AT-LV60PG484AC1/I0) — chân lấy từ Apicula examples/gw5a/tangconsole60k.cst
IO_LOC  "clk" V22;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "key_i" AA13;
IO_PORT "key_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "rst_i" AB13;
IO_PORT "rst_i" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// UART qua chip debugger BL616 (kênh B của 0403:6010)
IO_LOC  "RXD" V14;
IO_PORT "RXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC  "TXD" U15;
IO_PORT "TXD" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led[0]" V19;
IO_LOC  "led[1]" G22;
IO_LOC  "led[2]" E18;
IO_LOC  "led[3]" B22;
IO_LOC  "led[4]" V18;
IO_LOC  "led[5]" G21;
IO_LOC  "led[6]" F18;
IO_LOC  "led[7]" C22;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 DRIVE=8 BANK_VCCIO=3.3;
