// Tang Nano 4K — chân lấy từ Apicula examples/tangnano4k.cst
IO_LOC    "clk" 45;
IO_PORT   "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;
CLOCK_LOC "clk" BUFG;
IO_LOC  "mode_led" 10;
IO_PORT "mode_led" PULL_MODE=NONE DRIVE=8 IO_TYPE=LVCMOS33;
IO_LOC  "key_i" 15;
IO_PORT "key_i" PULL_MODE=UP IO_TYPE=LVCMOS18;
IO_LOC  "rst_i" 14;
IO_PORT "rst_i" PULL_MODE=UP IO_TYPE=LVCMOS18;
IO_LOC  "TXD" 44;
IO_PORT "TXD" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "RXD" 46;
IO_PORT "RXD" PULL_MODE=UP IO_TYPE=LVCMOS33;
