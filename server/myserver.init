#!/bin/sh /etc/rc.common
# Dịch vụ procd: tự chạy server khi board khởi động, tự bật lại nếu bị crash.
# Cài vào /etc/init.d/myserver, quản lý bằng: service myserver start|stop|restart|enable

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 /root/server/app.py
	procd_set_param env PORT=8080
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
