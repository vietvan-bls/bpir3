#!/bin/sh /etc/rc.common
# OpenOCD làm GDB server cho ST-Link (cổng 3333 GDB, 4444 telnet, chỉ 127.0.0.1).
# Cài vào /etc/init.d/openocd-stm32. Rút ST-Link -> OpenOCD thoát -> procd chạy lại mỗi 5 giây.
START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/openocd -f /etc/openocd/stm32.cfg
	procd_set_param respawn 0 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
