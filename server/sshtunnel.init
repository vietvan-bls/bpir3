#!/bin/sh /etc/rc.common
# SSH từ xa qua Cloudflare quick tunnel (không cần tài khoản).
#
# Tunnel trỏ vào một dropbear riêng chỉ nghe 127.0.0.1:2222 và CHỈ cho đăng nhập bằng khóa
# (uci dropbear.remote, PasswordAuth=off): người ngoài có link cũng không dò mật khẩu được.
# SSH trong mạng nội bộ (cổng 22) vẫn như cũ.
#
# Máy SSH vào cần cloudflared:
#   ssh -o ProxyCommand="cloudflared access ssh --hostname %h" root@xxx.trycloudflare.com
# Link đổi mỗi lần dịch vụ khởi động lại. Xem link hiện tại:  service sshtunnel url

START=99
USE_PROCD=1
LOG=/tmp/sshtunnel.log
EXTRA_COMMANDS="url"
EXTRA_HELP="	url	In ra hostname SSH hiện tại"

start_service() {
	: > "$LOG"
	procd_open_instance
	procd_set_param command /usr/bin/cloudflared tunnel --no-autoupdate \
		--url ssh://127.0.0.1:2222 --logfile "$LOG"
	procd_set_param respawn 3600 10 0
	procd_close_instance
}

url() {
	grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$LOG" | tail -1 | sed 's#https://##'
}
