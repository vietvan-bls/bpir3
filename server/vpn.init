#!/bin/sh /etc/rc.common
# VPN cho mạng WiFi của board (vpn.py). Cài vào /etc/init.d/bpi-vpn. Chỉ chạy khi đã bật trong /etc/bpi-vpn/state.json.
START=98
USE_PROCD=1

start_service() {
	grep -q '"enabled": true' /etc/bpi-vpn/state.json 2>/dev/null || return 0
	procd_open_instance
	procd_set_param command /usr/bin/python3 /root/server/vpn.py run
	procd_set_param respawn 0 10 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
